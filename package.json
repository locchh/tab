{
  "name": "tab",
  "displayName": "Tab",
  "publisher": "locchh",
  "version": "0.0.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/locchh/tab"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Tab",
      "properties": {
        "tab.mode": {
          "type": "string",
          "enum": [
            "paused",
            "internal",
            "external"
          ],
          "default": "internal",
          "enumDescriptions": [
            "No suggestions",
            "Tab's own agent suggests",
            "Other tools write suggestions to .tab/suggestion.json (see assets/SKILL.md)"
          ],
          "description": "Where suggestions come from."
        },
        "tab.effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "auto"
          ],
          "default": "low",
          "enumDescriptions": [
            "Finish the current line or sentence",
            "Finish the half-written block",
            "Write the whole file or document",
            "The agent decides how far to look and how much to write"
          ],
          "description": "How far the agent looks and how much it writes."
        },
        "tab.syncInterval": {
          "type": "number",
          "enum": [
            200,
            300,
            500
          ],
          "default": 300,
          "description": "How often (ms) Tab writes the current State to .tab/state.json."
        },
        "tab.autoSuggestDelay": {
          "type": "number",
          "enum": [
            1000,
            2000,
            5000
          ],
          "default": 2000,
          "description": "How long (ms) you must stop typing before Tab suggests."
        },
        "tab.agent": {
          "type": "string",
          "enum": [
            "claude",
            "codex"
          ],
          "default": "claude",
          "description": "Which agent CLI Tab uses. It must be installed and logged in."
        }
      }
    },
    "commands": [
      {
        "command": "tab.suggest",
        "title": "Tab: Suggest now"
      },
      {
        "command": "tab.menu",
        "title": "Tab: Settings"
      }
    ],
    "keybindings": [
      {
        "command": "tab.suggest",
        "key": "ctrl+alt+space",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build": "bun build src/extension.ts --outdir dist --target=node --format=cjs --external vscode",
    "typecheck": "tsc",
    "package": "bun run build && bunx @vscode/vsce package --no-dependencies",
    "test": "bun test ./test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "@types/vscode": "1.90.0",
    "typescript": "5.9.3"
  }
}

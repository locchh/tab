{
  "name": "tab",
  "displayName": "Tab",
  "publisher": "locchh",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/locchh/tab"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Tab",
      "properties": {
        "tab.syncInterval": {
          "type": "number",
          "enum": [
            200,
            300,
            500
          ],
          "default": 300,
          "description": "How often (ms) Tab writes the current State to .tab/state.json."
        },
        "tab.autoSuggestDelay": {
          "type": "number",
          "enum": [
            1000,
            2000,
            5000
          ],
          "default": 2000,
          "description": "How long (ms) you must stop typing before Tab suggests."
        }
      }
    },
    "commands": [
      {
        "command": "tab.suggest",
        "title": "Tab: Suggest now"
      }
    ],
    "keybindings": [
      {
        "command": "tab.suggest",
        "key": "ctrl+alt+space",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build": "bun build src/extension.ts --outdir dist --target=node --format=cjs --external vscode",
    "typecheck": "tsc",
    "package": "bun run build && bunx @vscode/vsce package --no-dependencies",
    "test": "bun test test/",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "@types/vscode": "1.90.0",
    "typescript": "5.9.3"
  }
}

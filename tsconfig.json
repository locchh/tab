{
  "compilerOptions": {
    // VS Code 1.90 runs Node 20
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "bun"],

    // Bun bundles; tsc only type-checks
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src", "test"]
}
